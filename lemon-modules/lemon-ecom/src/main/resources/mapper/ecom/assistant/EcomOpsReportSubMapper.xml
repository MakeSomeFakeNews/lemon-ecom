<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lemon.erp.modules.ecom.assistant.mapper.EcomOpsReportSubMapper">

    <select id="selectListWithUser" resultType="com.lemon.erp.modules.ecom.assistant.entity.EcomOpsReportSub">
        SELECT b.*, u.nickname AS user_name
        FROM ecom_ops_report_sub b
        LEFT JOIN sys_user u ON u.id = b.user_id
        ORDER BY b.id
    </select>
</mapper>
